@startuml
actor "Huésped" as H
participant "Recepcionista" as R
participant "Reservación" as RE
participant "Habitación" as HA
H -> R : Solicitar modificación
R -> RE : Buscar reservación
RE --> R : Datos de reservación
R -> HA : Consultar disponibilidad\npara nuevos datos
HA --> R : Disponibilidad
alt Disponible
    R -> RE : Modificar datos
    RE --> R : Cambios guardados
    R --> H : Confirmar modificación
else No disponible
    R --> H : Informar que no se puede modificar
end
@enduml