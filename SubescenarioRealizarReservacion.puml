@startuml
left to right direction
actor "Huésped" as H
rectangle "Realizar Reservación" {
    usecase "Realizar reservación" as Principal
    usecase "Consultar disponibilidad" as U1
    usecase "Registrar datos\ndel huésped" as U2
    usecase "Seleccionar habitación" as U3
    usecase "Confirmar reservación" as U4
    usecase "Rechazar reservación" as U5
}
actor "Recepcionista" as R
H --> Principal
Principal <-- R
Principal ..> U1 : <<include>>
Principal ..> U2 : <<include>>
Principal ..> U3 : <<include>>
U4 ..> Principal : <<extend>>\n[Disponible]
U5 ..> Principal : <<extend>>\n[No disponible]
@enduml
