@startuml
left to right direction
actor "Huésped" as H
rectangle "Registrar Pago" {
    usecase "Registrar pago" as Principal
    usecase "Buscar reservación" as U1
    usecase "Ingresar monto" as U2
    usecase "Seleccionar método\nde pago" as U3
    usecase "Confirmar pago" as U4
    usecase "Rechazar pago" as U5
}
actor "Recepcionista" as R
H --> Principal
Principal <-- R
Principal ..> U1 : <<include>>
Principal ..> U2 : <<include>>
Principal ..> U3 : <<include>>
U4 ..> Principal : <<extend>>\n[Pago válido]
U5 ..> Principal : <<extend>>\n[Pago inválido]
@enduml