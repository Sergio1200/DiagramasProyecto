@startuml
left to right direction
actor "Huésped" as H
rectangle "Consultar Disponibilidad" {
    usecase "Consultar disponibilidad" as Principal
    usecase "Ingresar fechas" as U1
    usecase "Buscar habitaciones" as U2
    usecase "Mostrar habitaciones\ndisponibles" as U3
    usecase "Informar sin\ndisponibilidad" as U4
}
actor "Recepcionista" as R
H --> Principal
Principal <-- R
Principal ..> U1 : <<include>>
Principal ..> U2 : <<include>>
U3 ..> Principal : <<extend>>\n[Hay habitaciones]
U4 ..> Principal : <<extend>>\n[No hay habitaciones]
@enduml


